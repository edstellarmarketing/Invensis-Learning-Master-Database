# Optional. Enables the AI-backed company search route (/api/companies/search).
# Without it, the dashboard, seed data, and manual "Add Company" still work fully.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Model used for AI company discovery. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. AI company discovery via OpenRouter (openrouter.ai) - use this if your key is
# an OpenRouter key (starts with sk-or-v1-), NOT an Anthropic key. Auto order is
# Claude -> OpenRouter -> Groq. In the UI, OpenRouter search exposes a model-family picker
# (Claude Sonnet / Gemini Flash / ChatGPT / DeepSeek / Other) crossed with a token-usage
# tier (Low/Medium/High) - see OPENROUTER_MODELS in src/app/api/companies/search/route.ts
# for the exact slug each combination resolves to. OPENROUTER_MODEL below is only the
# fallback used for the "Other" family when no custom slug is typed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5:online

# Optional fallback provider for AI company discovery (free tier at console.groq.com).
# Used when neither Anthropic nor OpenRouter keys are set, or when "Groq" is picked in the UI.
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile (answers from model knowledge, no live
# browsing - reliable on the free tier). groq/compound has built-in web search but its
# agentic tool chain burns 10-20k+ tokens per request, exhausting the free 30k TPM limit
# on a single call; only set this if you're on a paid Groq tier.
GROQ_MODEL=llama-3.3-70b-versatile

# Database (required for saving on Vercel; local dev falls back to JSON files).
# Auto-injected when you add the Upstash Redis integration in Vercel > Storage.
# Either pair works (Vercel may inject KV_REST_API_* instead of UPSTASH_REDIS_REST_*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Strongly recommended once Redis is configured (production). Since this app has no
# login, an unset token leaves full-DB replace-import and bulk-delete open to anyone
# with the URL. Set this and send it as the `x-admin-token` header from any admin
# tooling that calls those two endpoints. Unset = those routes stay open (local-dev
# default, matches the app's zero-config philosophy).
ADMIN_API_TOKEN=
