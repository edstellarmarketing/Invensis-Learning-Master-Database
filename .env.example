# Optional. Enables the AI-backed company search route (/api/companies/search).
# Without it, the dashboard, seed data, and manual "Add Company" still work fully.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional. Model used for AI company discovery. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional fallback provider for AI company discovery (free tier at console.groq.com).
# Used when ANTHROPIC_API_KEY is absent, or when the user picks Groq in the UI.
GROQ_API_KEY=
# Optional. Defaults to llama-3.3-70b-versatile (answers from model knowledge, no live
# browsing - reliable on the free tier). groq/compound has built-in web search but its
# agentic tool chain burns 10-20k+ tokens per request, exhausting the free 30k TPM limit
# on a single call; only set this if you're on a paid Groq tier.
GROQ_MODEL=llama-3.3-70b-versatile

# Database (required for saving on Vercel; local dev falls back to JSON files).
# Auto-injected when you add the Upstash Redis integration in Vercel > Storage.
# Either pair works (Vercel may inject KV_REST_API_* instead of UPSTASH_REDIS_REST_*).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
